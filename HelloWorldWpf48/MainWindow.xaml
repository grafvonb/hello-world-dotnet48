<Window x:Class="HelloWorldWpf48.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Users"
        Width="920" Height="560" MinWidth="600" MinHeight="340"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Users" FontSize="28" FontWeight="SemiBold" Foreground="#17304D" />
            <TextBlock Text="Names, logins, and ages from your user directory."
                       Margin="0,6,0,0" FontSize="14" Foreground="#526175" />
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#D5DDE7"
                BorderThickness="1" CornerRadius="6" Padding="16">
            <Grid>
                <DataGrid x:Name="UsersGrid"
                          AutomationProperties.AutomationId="UsersGrid"
                          AutomationProperties.Name="Users"
                          Visibility="Collapsed" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" CanUserReorderColumns="False"
                          EnableRowVirtualization="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="0" Background="White" FontSize="14"
                          MinRowHeight="36" ColumnHeaderHeight="36"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <Style x:Key="UserText" TargetType="{x:Type TextBlock}">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="8,4" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="180" ElementStyle="{StaticResource UserText}" />
                        <DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="*" MinWidth="180" ElementStyle="{StaticResource UserText}" />
                        <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock x:Name="LoadStatusText" Text="Loading users..."
                               AutomationProperties.AutomationId="LoadStatusText"
                               AutomationProperties.Name="User loading status"
                               TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="16" Foreground="#526175" />
                    <Button x:Name="RetryButton" Content="_Retry" Visibility="Collapsed" IsEnabled="False"
                            AutomationProperties.AutomationId="RetryButton"
                            AutomationProperties.Name="Retry loading users"
                            HorizontalAlignment="Center" Margin="0,16,0,0" Padding="24,8" FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
